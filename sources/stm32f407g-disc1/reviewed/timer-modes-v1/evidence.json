  "registers": {
    "ARR": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "ARR": "32-bit TIM2 reload; zero blocks counting. PWM uses period-1."
      },
      "offset": 44,
      "page": 638,
      "width": 32
    },
    "CCER": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CC1E": "PWM reference leaves0; input capture enables1 only after setup.",
        "CC1NP": "0; output mode requires it cleared; input pair00 selects rising.",
        "CC1P": "0 selects noninverted/rising polarity with CC1NP=0."
      },
      "offset": 32,
      "page": 636,
      "width": 32
    },
    "CCMR1": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {},
      "offset": 24,
      "page": 632,
      "width": 32
    },
    "CCR1": {
      "access": "mixed",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CCR1": "32-bit TIM2 value: output preload when OC1PE=1; read-only capture data when CC1S!=0; reading clears input CC1IF."
      },
      "offset": 52,
      "page": 639,
      "width": 32
    },
    "CNT": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CNT": "32-bit TIM2 counter; stopped writes/readback precede software capture."
      },
      "offset": 36,
      "page": 638,
      "width": 32
    },
    "CR1": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "ARPE": "1 buffers ARR; UG and later update events transfer its preload.",
        "CEN": "Enable counter last; keep zero for stopped software capture.",
        "CKD": "00 selects undivided digital-filter sampling basis.",
        "CMS": "00 selects edge-aligned mode.",
        "DIR": "0 selects upcounting.",
        "OPM": "0 leaves PWM continuous.",
        "UDIS": "0 permits update events/preload transfer.",
        "URS": "0 allows UG to set UIF; discard that stale flag."
      },
      "offset": 0,
      "page": 624,
      "width": 32
    },
    "CR2": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CCDS": "0; DMA requests remain disabled.",
        "MMS": "000 exposes UG on TRGO; require no downstream consumers.",
        "TI1S": "0 excludes the XOR input combination."
      },
      "offset": 4,
      "page": 625,
      "width": 32
    },
    "DIER": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CC1DE": "0 keeps capture/compare DMA disabled.",
        "CC1IE": "0 keeps capture/compare interrupts disabled.",
        "UDE": "0 keeps update DMA disabled.",
        "UIE": "0 keeps update interrupts disabled."
      },
      "offset": 12,
      "page": 629,
      "width": 32
    },
    "EGR": {
      "access": "WO",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CC1G": "Write1 in input mode captures CNT into CCR1 and sets capture/overcapture status.",
        "UG": "Write1 generates update/reinitialization and transfers preloads; never RMW."
      },
      "offset": 20,
      "page": 631,
      "width": 32
    },
    "PSC": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "PSC": "16-bit divider minus1, buffered until update. HSI16/1MHz gives15."
      },
      "offset": 40,
      "page": 638,
      "width": 32
    },
    "SMCR": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "ECE": "0 disables external clock mode2.",
        "SMS": "000 disables slave mode.",
        "TS": "000 selects TIM2 ITR0 from TIM1_TRGO; keep TIM1 gated."
      },
      "offset": 8,
      "page": 626,
      "width": 32
    },
    "SR": {
      "access": "RW",
      "access_widths": [
        32
      ],
      "field_meanings": {
        "CC1IF": "rc_w0; input capture sets this flag and reading CCR1 clears it.",
        "CC1OF": "rc_w0; another capture while CC1IF is set indicates lost/ambiguous data.",
        "UIF": "rc_w0; UG and natural updates set UIF; discard stale UIF before waiting."
      },
      "offset": 16,
      "page": 630,
      "width": 32
    }
  },
