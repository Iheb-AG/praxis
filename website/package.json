{
  "name": "praxis-documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "catalog": "node build.mjs && node scripts/licenses.mjs",
    "dev": "npm run catalog && vite --host 127.0.0.1",
    "build": "npm run catalog && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "mermaid": "12.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
