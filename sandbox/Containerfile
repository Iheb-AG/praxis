# Provisioning may use the network; verification never does. Supply an already-pulled,
# digest-pinned Debian bookworm base. The snapshot fixes the package universe.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN rm -f /etc/apt/sources.list.d/* \
    && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260201T000000Z bookworm main' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --no-install-recommends -y gcc-arm-none-eabi libnewlib-arm-none-eabi gcc-avr avr-libc \
    && dpkg-query -W > /toolchain-packages.txt \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /out
